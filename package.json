  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261014.1",
    "typescript": "^5.9.0",
    "wrangler": "^4.145.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["workerd", "esbuild", "protobufjs", "core-js-pure", "@google/genai"]
  }
}
